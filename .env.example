ELEVENLABS_API_KEY=
# Generate locally; at least 32 ASCII characters. Keep in ElevenAgents secret storage too.
FIL_WEBHOOK_SECRET=
FIL_DB_PATH=data/fil.sqlite
# Custom browser demo; fixed agent, never a VITE_* secret.
ELEVENLABS_AGENT_ID=
# Required for nonlocal hosting. Use HTTPS and secure cookies there.
FIL_DEMO_ACCESS_CODE=
FIL_DEMO_SECURE_COOKIES=false
FIL_DEMO_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
